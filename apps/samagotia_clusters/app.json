{
  "id": "samagotia_clusters",
  "title": "Samagotia Clusters",
  "description": "Custom instrument cluster designs for BMW iDrive 7. Includes F8X with live vehicle data and parked-test fallback to the BMW cluster.",
  "vendor": "Samagotia",
  "loggingId": "SMGC",
  "version": "0.16.3",
  "iconGlyph": "SMG",
  "shared": [
    "f8x_runtime.js",
    "f8x_motion.js",
    "f8x_page.js",
    "f8x_vehicle.js",
    "f8x_cruise.js",
    "f8x_cruise_art.js",
    "f8x_fuel_warning.js",
    "f8x_fuel_warning_art.js",
    "f8x_brake.js",
    "f8x_brake_art.js",
    "f8x_rpm_limit.js",
    "f8x_layouts.js",
    "f8x_data.js",
    "f8x_text.js",
    "f8x_icons.js",
    "f8x_shaders.js",
    "f82_sprite.js",
    "cluster_render_client.js",
    "f8x_info_data.js",
    "f8x_car_formats.js",
    "f8x_info_format.js",
    "f8x_doors.js",
    "f8x_door_art.js",
    "f8x_warning.js"
  ],
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs",
      "statusHandBrake": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs",
      "statusVehiclePartType": "rs"
    },
    "de.bmw.infrastructure.VehicleCondition": {
      "VehicleCondition": "s",
      "_optional": "F8x tachometer READY position and startup odometer"
    },
    "de.bmw.powertrain.AcceleratorPedal": {
      "AngleAcceleratorPedal": "s",
      "_optional": "F8x full-pedal shift lights"
    },
    "de.bmw.body.Light": {
      "StatusFunctionsIndicators": "s",
      "StatusFunctionsIndicators2": "s",
      "_optional": "F8x turn signals"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s",
      "DataPowerTrain2CRC": "s"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.KombiIF": {
      "statusRangeTankStatus": "rs",
      "statusBordcomputerAverage": "rs",
      "statusShowTimeDate": "rs",
      "_optional": "F8X optional information readings and displayed car time/date"
    },
    "de.bmw.infotainment.vehicle.Vehicle": {
      "statusDayNightChangeOver": "rs",
      "_optional": "F8X day/night artwork",
      "statusNewCurrentUnitsStatusExt": "rs"
    },
    "de.bmw.infotainment.misc.MDrive": {
      "dataDisplayGearbox": "s",
      "_optional": "S or M next to the gear"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "ExteriorTemperature": "s"
    },
    "de.bmw.infotainment.displaydata.DisplayDataServer2": {
      "functionalLibraryData": "rs",
      "_optional": "F8X cruise status and set-speed marker"
    },
    "de.bmw.body.DoorsWindowsRoofMirrors": {
      "CentralLockingSystemAndPanelStatus": "s",
      "CentralLockingSystemAndPanelStatus2": "s",
      "_optional": "F8X closure contact status; notification-only"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Samagotia Clusters",
      "buttons": [
        [
          "BTN_SETTINGS",
          "All settings"
        ]
      ]
    }
  ],
  "config": {
    "target": "panel",
    "parkedTest": true,
    "statusName": "Cluster",
    "socketPath": "/dev/shm/cluster-render/render.sock",
    "utcOffsetMinutes": null,
    "tankLitres": 65
  },
  "settings": [
